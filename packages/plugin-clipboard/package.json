{
  "name": "@nodebraid/plugin-clipboard",
  "type": "module",
  "version": "0.0.1",
  "description": "Clipboard Copy/Paste Runtime Plugins for NodeBraid.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/nodebraid.git",
    "directory": "packages/plugin-clipboard"
  },
  "bugs": "https://github.com/ZWkang/nodebraid/issues",
  "homepage": "https://github.com/ZWkang/nodebraid/tree/main/packages/plugin-clipboard#readme",
  "keywords": [
    "nodebraid",
    "clipboard",
    "copy-paste",
    "plugin-runtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build-workspaces.ts @nodebraid/plugin-clipboard",
    "build:self": "tsgo -p tsconfig.build.json && bun run test:artifacts",
    "build:dependencies": "bun run ../../scripts/build-workspaces.ts --dependencies @nodebraid/plugin-clipboard",
    "build:test-dependencies": "bun run ../../scripts/build-workspaces.ts --test-dependencies @nodebraid/plugin-clipboard",
    "prepack": "bun run build",
    "test": "bun run build:test-dependencies && bun run test:self",
    "test:self": "bun test ./tests",
    "test:artifacts": "bun run ./artifacts/check-declarations.ts",
    "typecheck": "bun run build:test-dependencies && bun run typecheck:self",
    "typecheck:self": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nodebraid/canvas-fragment": "workspace:*",
    "@nodebraid/diagnostics": "workspace:*",
    "@nodebraid/kernel": "workspace:*",
    "@nodebraid/plugin-command": "workspace:*",
    "@nodebraid/plugin-interaction": "workspace:*",
    "@nodebraid/plugin-kernel": "workspace:*",
    "@nodebraid/plugin-session": "workspace:*",
    "@nodebraid/runtime-cordis": "workspace:*"
  },
  "devDependencies": {
    "@nodebraid/plugin-duplicate-selection": "workspace:*",
    "@nodebraid/plugin-history": "workspace:*"
  }
}
