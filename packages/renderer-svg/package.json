{
  "name": "@cflow/renderer-svg",
  "type": "module",
  "version": "0.0.1",
  "description": "Reference-quality SVG Renderer Provider for CFlow.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/cflow.git",
    "directory": "packages/renderer-svg"
  },
  "bugs": "https://github.com/ZWkang/cflow/issues",
  "homepage": "https://github.com/ZWkang/cflow/tree/main/packages/renderer-svg#readme",
  "keywords": [
    "cflow",
    "canvas",
    "renderer",
    "svg"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsgo -p tsconfig.build.json --watch",
    "build": "bun run build:dependencies && tsgo -p tsconfig.build.json && bun run test:artifacts",
    "build:dependencies": "bun run --filter '@cflow/renderer-api' build",
    "build:test-dependencies": "bun run --filter '@cflow/plugin-renderer' build",
    "prepack": "bun run build",
    "test": "bun test ./tests",
    "test:artifacts": "bun run ./artifacts/check-declarations.ts",
    "test:browser": "bun run build:test-dependencies && bun run ./browser-tests/renderer-contract.browser.ts",
    "typecheck": "bun run build:test-dependencies && tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cflow/diagnostics": "workspace:*",
    "@cflow/interaction-api": "workspace:*",
    "@cflow/kernel": "workspace:*",
    "@cflow/renderer-api": "workspace:*",
    "@cflow/session-api": "workspace:*"
  }
}
