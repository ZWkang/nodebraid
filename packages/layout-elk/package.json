{
  "name": "@cflow/layout-elk",
  "type": "module",
  "version": "0.0.1",
  "description": "ELK Layout Provider for CFlow.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/cflow.git",
    "directory": "packages/layout-elk"
  },
  "bugs": "https://github.com/ZWkang/cflow/issues",
  "homepage": "https://github.com/ZWkang/cflow/tree/main/packages/layout-elk#readme",
  "keywords": [
    "cflow",
    "elk",
    "graph",
    "layout"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:dependencies && tsgo -p tsconfig.build.json && bun run ./artifacts/check-declarations.ts",
    "build:dependencies": "bun run --filter '@cflow/layout-api' build",
    "prepack": "bun run build",
    "test": "bun test ./tests",
    "typecheck": "bun run build:dependencies && tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cflow/layout-api": "workspace:*",
    "elkjs": "^0.12.0"
  }
}
