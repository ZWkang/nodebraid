{
  "name": "@nodebraid/plugin-duplicate-selection",
  "type": "module",
  "version": "0.0.1",
  "description": "Duplicate Selection Runtime Plugin for NodeBraid.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/nodebraid.git",
    "directory": "packages/plugin-duplicate-selection"
  },
  "bugs": "https://github.com/ZWkang/nodebraid/issues",
  "homepage": "https://github.com/ZWkang/nodebraid/tree/main/packages/plugin-duplicate-selection#readme",
  "keywords": [
    "nodebraid",
    "duplicate-selection",
    "plugin-runtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:dependencies && tsgo -p tsconfig.build.json && bun run test:artifacts",
    "build:dependencies": "bun run --filter '@nodebraid/plugin-command' build && bun run --filter '@nodebraid/plugin-kernel' build && bun run --filter '@nodebraid/plugin-session' build && bun run --filter '@nodebraid/plugin-interaction' build",
    "build:test-dependencies": "bun run build:dependencies && bun run --filter '@nodebraid/plugin-history' build",
    "prepack": "bun run build",
    "test": "bun run build:test-dependencies && bun test ./tests",
    "test:artifacts": "bun run ./artifacts/check-declarations.ts",
    "typecheck": "bun run build:test-dependencies && tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nodebraid/diagnostics": "workspace:*",
    "@nodebraid/kernel": "workspace:*",
    "@nodebraid/plugin-command": "workspace:*",
    "@nodebraid/plugin-interaction": "workspace:*",
    "@nodebraid/plugin-kernel": "workspace:*",
    "@nodebraid/plugin-session": "workspace:*",
    "@nodebraid/runtime-cordis": "workspace:*"
  },
  "devDependencies": {
    "@nodebraid/plugin-history": "workspace:*"
  }
}
