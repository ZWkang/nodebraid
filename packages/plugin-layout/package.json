{
  "name": "@nodebraid/plugin-layout",
  "type": "module",
  "version": "0.0.1",
  "description": "Runtime Command integration for NodeBraid Layout Engines.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/nodebraid.git",
    "directory": "packages/plugin-layout"
  },
  "bugs": "https://github.com/ZWkang/nodebraid/issues",
  "homepage": "https://github.com/ZWkang/nodebraid/tree/main/packages/plugin-layout#readme",
  "keywords": [
    "nodebraid",
    "layout",
    "plugin-runtime",
    "command"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:dependencies && tsgo -p tsconfig.build.json && bun run ./artifacts/check-declarations.ts",
    "build:dependencies": "bun run --filter '@nodebraid/layout-api' build && bun run --filter '@nodebraid/plugin-kernel' build && bun run --filter '@nodebraid/plugin-command' build",
    "prepack": "bun run build",
    "test": "bun test ./tests",
    "typecheck": "bun run build:dependencies && tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nodebraid/layout-api": "workspace:*",
    "@nodebraid/plugin-command": "workspace:*",
    "@nodebraid/plugin-kernel": "workspace:*",
    "@nodebraid/runtime-cordis": "workspace:*"
  }
}
