{
  "name": "@cflow/plugin-interaction",
  "type": "module",
  "version": "0.0.1",
  "description": "Interaction Runtime Plugin for CFlow.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/cflow.git",
    "directory": "packages/plugin-interaction"
  },
  "bugs": "https://github.com/ZWkang/cflow/issues",
  "homepage": "https://github.com/ZWkang/cflow/tree/main/packages/plugin-interaction#readme",
  "keywords": [
    "cflow",
    "interaction",
    "plugin-runtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsgo -p tsconfig.build.json --watch",
    "build": "bun run build:dependencies && tsgo -p tsconfig.build.json && bun run test:artifacts",
    "build:dependencies": "bun run --filter '@cflow/plugin-command' build && bun run --filter '@cflow/plugin-kernel' build && bun run --filter '@cflow/plugin-session' build && bun run --filter '@cflow/plugin-renderer' build",
    "prepack": "bun run build",
    "test": "bun test ./tests",
    "test:artifacts": "bun run ./artifacts/check-declarations.ts",
    "typecheck": "bun run build:dependencies && tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cflow/interaction-api": "workspace:*",
    "@cflow/plugin-command": "workspace:*",
    "@cflow/plugin-kernel": "workspace:*",
    "@cflow/plugin-renderer": "workspace:*",
    "@cflow/plugin-session": "workspace:*",
    "@cflow/renderer-api": "workspace:*",
    "@cflow/runtime-cordis": "workspace:*"
  }
}
