{
  "name": "@nodebraid/plugin-interaction",
  "type": "module",
  "version": "0.0.1",
  "description": "Interaction Runtime Plugin for NodeBraid.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/nodebraid.git",
    "directory": "packages/plugin-interaction"
  },
  "bugs": "https://github.com/ZWkang/nodebraid/issues",
  "homepage": "https://github.com/ZWkang/nodebraid/tree/main/packages/plugin-interaction#readme",
  "keywords": [
    "nodebraid",
    "interaction",
    "plugin-runtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsgo -p tsconfig.build.json --watch",
    "build": "bun run ../../scripts/build-workspaces.ts @nodebraid/plugin-interaction",
    "build:self": "tsgo -p tsconfig.build.json && bun run test:artifacts",
    "build:dependencies": "bun run ../../scripts/build-workspaces.ts --dependencies @nodebraid/plugin-interaction",
    "build:test-dependencies": "bun run ../../scripts/build-workspaces.ts --test-dependencies @nodebraid/plugin-interaction",
    "prepack": "bun run build",
    "test": "bun run build:test-dependencies && bun run test:self",
    "test:self": "bun test ./tests",
    "test:artifacts": "bun run ./artifacts/check-declarations.ts",
    "typecheck": "bun run build:test-dependencies && bun run typecheck:self",
    "typecheck:self": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nodebraid/diagnostics": "workspace:*",
    "@nodebraid/interaction-api": "workspace:*",
    "@nodebraid/kernel": "workspace:*",
    "@nodebraid/plugin-command": "workspace:*",
    "@nodebraid/plugin-kernel": "workspace:*",
    "@nodebraid/plugin-node-editing": "workspace:*",
    "@nodebraid/plugin-port": "workspace:*",
    "@nodebraid/plugin-renderer": "workspace:*",
    "@nodebraid/plugin-session": "workspace:*",
    "@nodebraid/port-api": "workspace:*",
    "@nodebraid/renderer-api": "workspace:*",
    "@nodebraid/runtime-cordis": "workspace:*"
  },
  "devDependencies": {
    "@nodebraid/plugin-history": "workspace:*"
  }
}
