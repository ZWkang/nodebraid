{
  "name": "@nodebraid/plugin-node-editing",
  "type": "module",
  "version": "0.0.1",
  "description": "Headless Node creation and data editing Commands for NodeBraid.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/nodebraid.git",
    "directory": "packages/plugin-node-editing"
  },
  "bugs": "https://github.com/ZWkang/nodebraid/issues",
  "homepage": "https://github.com/ZWkang/nodebraid/tree/main/packages/plugin-node-editing#readme",
  "keywords": [
    "nodebraid",
    "node",
    "editing",
    "command"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build-workspaces.ts @nodebraid/plugin-node-editing",
    "build:self": "tsgo -p tsconfig.build.json && bun run ./artifacts/check-declarations.ts",
    "build:dependencies": "bun run ../../scripts/build-workspaces.ts --dependencies @nodebraid/plugin-node-editing",
    "prepack": "bun run build",
    "test": "bun run build:test-dependencies && bun run test:self",
    "test:self": "bun test ./tests",
    "typecheck": "bun run build:test-dependencies && bun run typecheck:self",
    "typecheck:self": "tsgo --noEmit -p tsconfig.json",
    "build:test-dependencies": "bun run ../../scripts/build-workspaces.ts --test-dependencies @nodebraid/plugin-node-editing"
  },
  "dependencies": {
    "@nodebraid/diagnostics": "workspace:*",
    "@nodebraid/kernel": "workspace:*",
    "@nodebraid/plugin-command": "workspace:*",
    "@nodebraid/plugin-kernel": "workspace:*",
    "@nodebraid/runtime-cordis": "workspace:*"
  },
  "devDependencies": {
    "@nodebraid/plugin-history": "workspace:*"
  }
}
