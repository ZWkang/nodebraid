{
  "name": "@nodebraid/adapter-react",
  "type": "module",
  "version": "0.0.1",
  "description": "React lifecycle and stable Snapshot projection for NodeBraid runtimes.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWkang/nodebraid.git",
    "directory": "packages/adapter-react"
  },
  "bugs": "https://github.com/ZWkang/nodebraid/issues",
  "homepage": "https://github.com/ZWkang/nodebraid/tree/main/packages/adapter-react#readme",
  "keywords": [
    "nodebraid",
    "react",
    "adapter",
    "canvas-runtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsgo -p tsconfig.build.json --watch",
    "build": "bun run build:dependencies && tsgo -p tsconfig.build.json && bun run ./artifacts/check-declarations.ts",
    "build:dependencies": "bun run --filter '@nodebraid/plugin-kernel' build && bun run --filter '@nodebraid/plugin-session' build && bun run --filter '@nodebraid/plugin-history' build",
    "prepack": "bun run build",
    "test": "bun test ./tests",
    "test:browser": "bun run build && bun run ./browser-tests/runtime-mount.browser.ts",
    "typecheck": "bun run build:dependencies && tsgo --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@nodebraid/kernel": "workspace:*",
    "@nodebraid/plugin-history": "workspace:*",
    "@nodebraid/plugin-kernel": "workspace:*",
    "@nodebraid/plugin-session": "workspace:*"
  }
}
