import assert from 'node:assert/strict';
import { createCanvasKernel, nodeId } from '@nodebraid/kernel';
import { serializeCanvasDocument, deserializeCanvasDocument } from '@nodebraid/document';
import { createPluginHost, definePlugin } from '@nodebraid/runtime-cordis';
import { commandPlugin, commandService } from '@nodebraid/plugin-command';
import { kernelPlugin, kernelService } from '@nodebraid/plugin-kernel';
import { historyPlugin, historyService, establishHistoryBaselineCommand, undoCommand, redoCommand } from '@nodebraid/plugin-history';
import { portPlugin } from '@nodebraid/plugin-port';
import { sessionPlugin } from '@nodebraid/plugin-session';
import { createRendererPlugin } from '@nodebraid/plugin-renderer';
import { interactionPlugin, moveNodesCommand } from '@nodebraid/plugin-interaction';

const a=nodeId('saved-a'), b=nodeId('saved-b'), old=nodeId('old');
const source=createCanvasKernel();
source.transact(tx=>{
  tx.nodes.add({id:a,type:'group',position:{x:0,y:0},size:{width:120,height:80},data:new Map([['note','parent']])});
  tx.nodes.add({id:b,type:'task',position:{x:100,y:0},size:{width:20,height:30},parentId:a,data:new Map([['note','child']])});
});
const codec={
  format:'review/map-note-v1',
  encode(value){assert.ok(value instanceof Map); return JSON.stringify([...value]);},
  decode(text){return new Map(JSON.parse(text));},
};
const document=deserializeCanvasDocument(serializeCanvasDocument(source.read().snapshot,codec),codec);
let services;
const consumer=definePlugin({
  requires:{commands:commandService,kernel:kernelService,history:historyService},
  setup(context){services=context.services;},
});
// Explicit external Renderer backend; all NodeBraid services below are actual public Plugins.
const renderer={
  updateDocument(){},updateSession(){},updateInteraction(){},
  subscribeInput(){return ()=>{};},hitTest(){return null;},
  capturePointer(){},releasePointer(){},focus(){},async dispose(){},
};
const host=createPluginHost();
let observed;
try{
  await Promise.all([
    host.install(kernelPlugin),host.install(commandPlugin),host.install(historyPlugin),
    host.install(portPlugin),host.install(sessionPlugin),host.install(createRendererPlugin(()=>renderer)),
    host.install(interactionPlugin),host.install(consumer),
  ].map(installation=>installation.whenActive()));
  assert.ok(services);
  const {commands,kernel,history}=services;
  kernel.transact(tx=>tx.nodes.add({id:old,type:'old',position:{x:0,y:0},data:null}));
  await commands.execute(undoCommand,undefined);
  assert.deepEqual(history.getSnapshot(),{canUndo:false,canRedo:true});
  const baseline=await commands.execute(establishHistoryBaselineCommand,tx=>{
    const current=kernel.read().snapshot;
    for(const edge of current.edges)tx.edges.remove(edge.id);
    for(const node of current.nodes)tx.nodes.remove(node.id);
    for(const node of document.nodes)tx.nodes.add(node);
    for(const edge of document.edges)tx.edges.add(edge);
  });
  assert.ok(baseline);
  const restored=kernel.read(), baselineHistory=history.getSnapshot();
  assert.strictEqual(restored,baseline.after);
  assert.deepEqual(baselineHistory,{canUndo:false,canRedo:false});
  const aData=restored.query.getNode(a).data,bData=restored.query.getNode(b).data;
  assert.ok(aData instanceof Map); assert.ok(bData instanceof Map);
  const noop=await commands.execute(moveNodesCommand,{moves:[
    {nodeId:a,basePosition:{x:0,y:0},position:{x:0,y:0}},
  ]});
  assert.equal(noop,null);
  assert.strictEqual(kernel.read(),restored);
  assert.strictEqual(history.getSnapshot(),baselineHistory);

  let rootReads=0,lengthReads=0,xReads=0,yReads=0;
  const point={
    get x(){xReads++;return xReads===1?15:NaN;},
    get y(){yReads++;return yReads===1?25:NaN;},
  };
  const entries=[
    {nodeId:a,basePosition:{x:0,y:0},position:point},
    {nodeId:b,basePosition:{x:100,y:0},position:{x:130,y:40}},
  ];
  Object.defineProperty(entries,Symbol.iterator,{get(){throw new Error('Caller iterator must not be read');}});
  const moves=new Proxy(entries,{get(target,key,receiver){
    if(key==='length')lengthReads++;
    return Reflect.get(target,key,receiver);
  }});
  const input={get moves(){assert.strictEqual(this,input);rootReads++;return moves;}};
  const commit=await commands.execute(moveNodesCommand,input);
  assert.ok(commit);
  assert.strictEqual(commit.before,restored);
  assert.equal(commit.changeSet.origin,'interaction');
  assert.equal(commit.changeSet.commandId,'interaction.nodes.move');
  assert.deepEqual(commit.changeSet.changes.map(change=>change.id),[a,b]);
  assert.deepEqual(kernel.read().query.getNode(a).position,{x:15,y:25});
  assert.deepEqual(kernel.read().query.getNode(b).position,{x:130,y:40});
  assert.equal(kernel.read().query.getNode(b).parentId,a);
  assert.deepEqual(kernel.read().query.getNode(b).size,{width:20,height:30});
  assert.strictEqual(kernel.read().query.getNode(a).data,aData);
  assert.strictEqual(kernel.read().query.getNode(b).data,bData);
  assert.equal(Object.isFrozen(bData),false);
  assert.deepEqual(history.getSnapshot(),{canUndo:true,canRedo:false});
  assert.deepEqual([rootReads,lengthReads,xReads,yReads],[1,1,1,1]);
  await commands.execute(undoCommand,undefined);
  assert.deepEqual(kernel.read().query.getNode(a).position,{x:0,y:0});
  assert.deepEqual(kernel.read().query.getNode(b).position,{x:100,y:0});
  assert.deepEqual(history.getSnapshot(),{canUndo:false,canRedo:true});
  await assert.rejects(commands.execute(undoCommand,undefined),error=>error.code==='UNDO_EMPTY');
  await commands.execute(redoCommand,undefined);
  assert.deepEqual(kernel.read().query.getNode(a).position,{x:15,y:25});
  assert.deepEqual(kernel.read().query.getNode(b).position,{x:130,y:40});
  assert.equal(kernel.read().query.getNode(b).parentId,a);
  assert.strictEqual(kernel.read().query.getNode(a).data,aData);
  assert.strictEqual(kernel.read().query.getNode(b).data,bData);
  assert.deepEqual(history.getSnapshot(),{canUndo:true,canRedo:false});
  assert.deepEqual([rootReads,lengthReads,xReads,yReads],[1,1,1,1]);
  observed={baselineRevision:baseline.after.snapshot.revision,moveRevision:commit.after.snapshot.revision,
    rootReads,lengthReads,xReads,yReads,noOpViewIdentity:true,baselinePreservedAfterUndo:true,opaqueDataIdentity:true};
}finally{
  await host.dispose();
}
console.log(JSON.stringify(observed));
