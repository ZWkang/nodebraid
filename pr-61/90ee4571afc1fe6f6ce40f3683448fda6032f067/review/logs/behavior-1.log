from pathlib import Path
import json, re, shutil, subprocess, sys, tempfile

root = Path(sys.argv[1]).resolve()
print("Reproducer source:\n" + Path(__file__).read_text(), flush=True)
print("Source HEAD:", subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip(), flush=True)
principles = sorted((root / ".agents/skills").glob("principle-*/SKILL.md"))
assert len(principles) == 24
for path in principles:
    subprocess.run(["python3", "/Users/zhou/.codex/skills/.system/skill-creator/scripts/quick_validate.py", str(path.parent)], check=True)
changed = subprocess.check_output(["git", "diff", "--name-only", "0849c19674eb9a2fe5f6faff7ab90716c3341486", "HEAD"], cwd=root, text=True).splitlines()
count = 0
for name in changed:
    path = root / name
    if path.suffix != ".md":
        continue
    for target in re.findall(r"\]\(([^)]+)\)", path.read_text()):
        if "://" in target or target.startswith("#") or " " in target:
            continue
        assert (path.parent / target.split("#", 1)[0]).resolve().exists(), (name, target)
        count += 1
print(f"All 24 definitions validate; {count} local links resolve.", flush=True)
with tempfile.TemporaryDirectory(prefix="principle-contract-") as temp:
    fixture = Path(temp)
    for folder in [".agents", "docs", "scripts", ".github/workflows"]:
        shutil.copytree(root / folder, fixture / folder)
    for name in ["AGENTS.md", "CONTEXT.md"]:
        shutil.copyfile(root / name, fixture / name)
    def check():
        result = subprocess.run(["bun", str(root / "scripts/check-agent-workflows.ts")], cwd=fixture, text=True, capture_output=True)
        print(result.stdout, end="", flush=True)
        print(result.stderr, end="", flush=True)
        return result
    assert check().returncode == 0
    candidates = sorted((fixture / ".agents/skills").glob("principle-*/SKILL.md")) + [fixture / "docs/agents/principles.md", fixture / ".agents/skills/PSTACK-LICENSE"]
    for path in candidates:
        data = path.read_bytes()
        path.unlink()
        try:
            result = check()
            relative = str(path.relative_to(fixture))
            assert result.returncode != 0, relative
            assert f"Missing local workflow source: {relative}" in result.stderr, result.stderr
            print(f"Expected rejection verified: {relative}; exit {result.returncode}", flush=True)
        finally:
            path.write_bytes(data)
    assert check().returncode == 0
print("PASS: all 26 required source omissions rejected; complete and restored source sets accepted.", flush=True)

