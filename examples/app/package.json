{
  "name": "@nodebraid/examples",
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nodebraid/adapter-react": "workspace:*",
    "@nodebraid/core": "workspace:*",
    "@nodebraid/layout-dagre": "workspace:*",
    "@nodebraid/renderer-svg": "workspace:*",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-workspaces.ts @nodebraid/examples",
    "build:self": "vite build",
    "build:dependencies": "bun run ../../scripts/build-workspaces.ts --dependencies @nodebraid/examples",
    "check": "bun run build && bun run typecheck:self && bun run test:browser:self",
    "dev": "bun run build:dependencies && vite --host 127.0.0.1",
    "test": "bun run build && bun run test:browser:self",
    "test:browser": "bun run build && bun run test:browser:self",
    "test:browser:self": "bun run ./browser-tests/basic-svg.browser.ts && bun run ./browser-tests/clipboard.browser.ts && bun run ./browser-tests/document.browser.ts",
    "typecheck": "bun run build:dependencies && bun run typecheck:self",
    "typecheck:self": "tsgo --noEmit -p tsconfig.json"
  }
}
