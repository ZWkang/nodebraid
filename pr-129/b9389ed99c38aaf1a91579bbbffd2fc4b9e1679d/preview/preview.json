      ]
    },
    {
      "id": "clipboard",
      "title": "Copy and paste through the system clipboard",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Grant clipboard permission only to this isolated browser context",
        "Copy Discover, paste it, and verify the resulting Canvas"
      ],
      "artifacts": [
        "clipboard/before.png",
