  "limitations": [
    "These preview scenes cover Canvas behavior, not Layout execution. The Basic SVG browser suite verifies the manual Auto layout control; capture its interaction separately for Layout evidence."
  ],
  "scenes": [
    {
      "id": "viewport",
      "title": "Viewport zoom and reset",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Zoom in through the toolbar; verify 1.20× and unchanged Document",
        "Reset view; verify the initial 1.00× Viewport"
      ],
      "artifacts": [
        "viewport/before.png",
        "viewport/before.snapshot.json",
        "viewport/zoomed.png",
        "viewport/zoomed.snapshot.json",
        "viewport/after.png",
        "viewport/after.snapshot.json",
        "viewport/recording.mp4",
        "viewport/review-encoding.log",
        "viewport/review.mp4",
        "viewport/actions.log"
      ]
    },
    {
      "id": "selection-history",
      "title": "Selection, duplication and history",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Select Discover and duplicate using a native keyboard shortcut",
        "Undo and redo the duplicate; verify Document counts and revision"
      ],
      "artifacts": [
        "selection-history/before.png",
        "selection-history/before.snapshot.json",
        "selection-history/duplicated.png",
        "selection-history/duplicated.snapshot.json",
        "selection-history/after.png",
        "selection-history/after.snapshot.json",
        "selection-history/recording.mp4",
        "selection-history/review-encoding.log",
        "selection-history/review.mp4",
        "selection-history/actions.log"
      ]
    },
    {
      "id": "port-connection",
      "title": "Connect source and target Ports",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Drag Compose output Port onto Ship input Port"
      ],
      "artifacts": [
        "port-connection/before.png",
        "port-connection/before.snapshot.json",
        "port-connection/connecting.png",
        "port-connection/connecting.snapshot.json",
        "port-connection/after.png",
        "port-connection/after.snapshot.json",
        "port-connection/recording.mp4",
        "port-connection/review-encoding.log",
        "port-connection/review.mp4",
        "port-connection/actions.log"
      ]
    },
    {
      "id": "clipboard",
      "title": "Copy and paste through the system clipboard",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Grant clipboard permission only to this isolated browser context",
        "Copy Discover, paste it, and verify the resulting Canvas"
      ],
      "artifacts": [
        "clipboard/before.png",
        "clipboard/before.snapshot.json",
        "clipboard/after.png",
        "clipboard/after.snapshot.json",
        "clipboard/recording.mp4",
        "clipboard/review-encoding.log",
        "clipboard/review.mp4",
        "clipboard/actions.log"
      ]
    },
    {
      "id": "document-files",
      "title": "Export and restore a complete Document file",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Edit and download a real complete Document file",
        "Reopen the application and upload the downloaded file",
        "Continue editing and Undo only the new edit"
      ],
      "artifacts": [
        "document-files/before.png",
