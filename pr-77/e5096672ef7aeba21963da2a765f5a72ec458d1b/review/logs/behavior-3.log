$ bun - <<'TS'
import assert from 'node:assert/strict';
import { nodeId, edgeId } from '@nodebraid/kernel';
import { kernelPlugin, kernelService } from '@nodebraid/plugin-kernel';
import { createPluginHost, definePlugin } from '@nodebraid/runtime-cordis';
import { sessionPlugin, sessionService } from './packages/plugin-session/src/index.ts';
const a=nodeId('a'),b=nodeId('b'),ab=edgeId('ab');
let checked=0;
for(const field of ['nodeIds','edgeIds']) for(const mode of ['bigint','symbol','coercion-error','infinity-index-error']) {
 const marker=new Error(field+':'+mode);
 let kernel,session,indexReads=0,lengthReads=0,coercions=0;
 const consumer=definePlugin({requires:{kernel:kernelService,session:sessionService},setup(context){kernel=context.services.kernel;session=context.services.session;}});
 const host=createPluginHost();
 try{
  const installs=[host.install(kernelPlugin),host.install(sessionPlugin),host.install(consumer)];
  await Promise.all(installs.map(i=>i.whenActive()));
  assert.ok(kernel&&session);
  kernel.transact(tx=>{
   for(const id of [a,b]) tx.nodes.add({id,type:'task',position:{x:0,y:0},data:null});
   tx.edges.add({id:ab,type:'flow',source:{nodeId:a},target:{nodeId:b},data:null});
  });
  session.setSelection({nodeIds:[a],edgeIds:[]});
  const before=session.getSnapshot();
  const incoming=new Proxy(field==='nodeIds'?[b]:[ab],{get(target,key,receiver){
   if(key==='length'){lengthReads++;
    if(mode==='bigint') return 1n;
    if(mode==='symbol') return Symbol('length');
    if(mode==='coercion-error') return {valueOf(){coercions++;throw marker;}};
    return Infinity;
   }
   if(key==='0'){indexReads++;if(mode==='infinity-index-error') throw marker;}
   return Reflect.get(target,key,receiver);
  }});
  const input={nodeIds:[a],edgeIds:[]};
  input[field]=incoming;
  let error;
  try{session.setSelection(input);}catch(e){error=e;}
  if(mode==='bigint'||mode==='symbol') assert.ok(error instanceof TypeError);
  else assert.equal(error,marker);
  assert.equal(session.getSnapshot(),before);
  assert.equal(lengthReads,1);
  assert.equal(indexReads,mode==='infinity-index-error'?1:0);
  assert.equal(coercions,mode==='coercion-error'?1:0);
  checked++;
  console.log(JSON.stringify({field,mode,error:mode==='bigint'||mode==='symbol'?'TypeError':'original marker',lengthReads,indexReads,coercions,snapshotUnchanged:true}));
 }finally{await host.dispose();}
}
assert.equal(checked,8);
console.log('8 native-length/public Host cases passed');
