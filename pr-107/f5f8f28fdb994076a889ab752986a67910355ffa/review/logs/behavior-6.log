bun - <<'JS'
import assert from 'node:assert/strict';
import { createCanvasKernel, nodeId, edgeId } from '@nodebraid/kernel';
import { serializeCanvasDocument, deserializeCanvasDocument } from '@nodebraid/document';
import { createPluginHost, definePlugin } from '@nodebraid/runtime-cordis';
import { commandPlugin, commandService } from '@nodebraid/plugin-command';
import { kernelPlugin, kernelService } from '@nodebraid/plugin-kernel';
import { historyPlugin, historyService, establishHistoryBaselineCommand, undoCommand, redoCommand } from '@nodebraid/plugin-history';
import { portPlugin } from '@nodebraid/plugin-port';
import { sessionPlugin } from '@nodebraid/plugin-session';
import { createRendererPlugin } from '@nodebraid/plugin-renderer';
import { interactionPlugin, createEdgeCommand } from '@nodebraid/plugin-interaction';

const a = nodeId('saved-a'), b = nodeId('saved-b'), old = nodeId('old');
const source = createCanvasKernel();
source.transact(tx => {
  tx.nodes.add({ id: a, type: 'task', position: { x: 0, y: 0 }, data: null });
  tx.nodes.add({ id: b, type: 'task', position: { x: 120, y: 0 }, data: null });
});
const codec = {
  format: 'review/null-v1',
  encode(value) { assert.equal(value, null); return 'null'; },
  decode(text) { assert.equal(text, 'null'); return null; },
};
const document = deserializeCanvasDocument(serializeCanvasDocument(source.read().snapshot, codec), codec);
let services;
const consumer = definePlugin({
  requires: { commands: commandService, kernel: kernelService, history: historyService },
  setup(context) { services = context.services; },
});
// Explicit external Renderer backend. All Host/Kernel/Command/History/Interaction services are real.
const renderer = {
  updateDocument() {}, updateSession() {}, updateInteraction() {},
  subscribeInput() { return () => {}; }, hitTest() { return null; },
  capturePointer() {}, releasePointer() {}, focus() {}, async dispose() {},
};
const host = createPluginHost();
let observed;
try {
  await Promise.all([
    host.install(kernelPlugin), host.install(commandPlugin), host.install(historyPlugin),
    host.install(portPlugin), host.install(sessionPlugin),
    host.install(createRendererPlugin(() => renderer)), host.install(interactionPlugin), host.install(consumer),
  ].map(installation => installation.whenActive()));
  assert.ok(services);
  const { commands, kernel, history } = services;
  kernel.transact(tx => tx.nodes.add({ id: old, type: 'old', position: { x: 0, y: 0 }, data: null }));
  await commands.execute(undoCommand, undefined);
  assert.deepEqual(history.getSnapshot(), { canUndo: false, canRedo: true });
  const baseline = await commands.execute(establishHistoryBaselineCommand, tx => {
    const current = kernel.read().snapshot;
    for (const edge of current.edges) tx.edges.remove(edge.id);
    for (const node of current.nodes) tx.nodes.remove(node.id);
    for (const node of document.nodes) tx.nodes.add(node);
    for (const edge of document.edges) tx.edges.add(edge);
  });
  assert.ok(baseline);
  const restored = kernel.read();
  assert.strictEqual(baseline.after, restored);
  assert.deepEqual(history.getSnapshot(), { canUndo: false, canRedo: false });
  await assert.rejects(commands.execute(redoCommand, undefined), error => error.code === 'REDO_EMPTY');
  let rootReads = 0, dataReads = 0;
  const opaque = new Map([['domain', { value: 7 }]]);
  const id = edgeId('after-baseline');
  const accepted = {
    id, type: 'flow', source: { nodeId: a }, target: { nodeId: b },
    get data() { assert.strictEqual(this, accepted); dataReads++; return opaque; },
  };
  const substituted = { id, type: 'flow', source: { nodeId: a }, target: { nodeId: a }, data: opaque };
  const input = {
    get edge() { rootReads++; return rootReads === 1 ? accepted : substituted; },
    source: { nodeId: a, role: 'source' }, target: { nodeId: b, role: 'target' },
  };
  const commit = await commands.execute(createEdgeCommand, input);
  assert.strictEqual(commit.before, restored);
  assert.equal(commit.changeSet.origin, 'interaction');
  assert.equal(commit.changeSet.commandId, 'interaction.edge.create');
  assert.equal(commit.changeSet.changes.length, 1);
  assert.equal(commit.changeSet.changes[0].entity, 'edge');
  assert.equal(kernel.read().query.getEdge(id).target.nodeId, b);
  assert.strictEqual(kernel.read().query.getEdge(id).data, opaque);
  assert.equal(Object.isFrozen(opaque), false);
  assert.deepEqual(history.getSnapshot(), { canUndo: true, canRedo: false });
  assert.equal(rootReads, 1); assert.equal(dataReads, 1);
  await commands.execute(undoCommand, undefined);
  assert.equal(kernel.read().query.getEdge(id), undefined);
  assert.strictEqual(kernel.read().query.getNode(a), restored.query.getNode(a));
  assert.strictEqual(kernel.read().query.getNode(b), restored.query.getNode(b));
  assert.deepEqual(history.getSnapshot(), { canUndo: false, canRedo: true });
  await commands.execute(redoCommand, undefined);
  assert.equal(kernel.read().query.getEdge(id).target.nodeId, b);
  assert.strictEqual(kernel.read().query.getEdge(id).data, opaque);
  assert.deepEqual(history.getSnapshot(), { canUndo: true, canRedo: false });
  assert.equal(rootReads, 1); assert.equal(dataReads, 1);
  observed = { baselineRevision: baseline.after.snapshot.revision, edgeCommitRevision: commit.after.snapshot.revision,
    rootReads, dataReads, baselineNodesPreserved: true, redoDataIdentity: true };
} finally {
  await host.dispose();
}
console.log(JSON.stringify(observed));
