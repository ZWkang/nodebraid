2026-11-26T10:15:33.820Z $ agent-browser --session nb-preview-71354-cab3cf6a --config "/Users/zhou/.codex/local-workflows/nodebraid/runs/issue-161-edge-label/evidence/port-connection/browser-config.json" "eval" "(() => {\n            const path = document.querySelector('[data-nodebraid-edge-id=\"example-edge-2\"] [data-nodebraid-edge-path]');\n            if (!(path instanceof SVGPathElement)) throw new Error('Missing readable Edge path.');\n            const local = path.getPointAtLength(path.getTotalLength() / 2);\n            const matrix = path.getScreenCTM();\n            if (!matrix) throw new Error('Missing Edge screen mapping.');\n            const screen = new DOMPoint(local.x, local.y).matrixTransform(matrix);\n            return {x: screen.x, y: screen.y};\n          })()" "--json"
