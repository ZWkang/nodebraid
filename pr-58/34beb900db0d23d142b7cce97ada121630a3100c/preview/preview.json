      ]
    },
    {
      "id": "port-connection",
      "title": "Connect source and target Ports",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Drag Compose output Port onto Ship input Port"
      ],
      "artifacts": [
        "port-connection/before.png",
