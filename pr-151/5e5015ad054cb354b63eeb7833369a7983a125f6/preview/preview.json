    },
    {
      "id": "port-connection",
      "title": "Connect source and target Ports",
      "status": "passed",
      "steps": [
        "Doctor: wait for the real Examples Application and its initial Canvas",
        "Check the initial orthogonal Edge, direction arrow and application label",
        "Drag Compose output Port onto Ship input Port to create a Bezier Edge",
        "Repeat the same connection and select each separate parallel path with native input"
      ],
